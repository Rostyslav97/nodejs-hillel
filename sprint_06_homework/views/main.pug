extends template

block content
  .container.mt-4

    h1.text-center.mb-4 Phones
    .row
      each item in phones
        .col-md-3.mb-4
          .card.h-100.p-2
            img.card-img-top(src=item.image)
            .card-body
              h5.card-title= item.title
              p.card-text= item.description
              p.card-text
                b Price: #{item.price}$
              p.card-text
                | In stock: #{item.stock}
            .card-footer
              a.btn.btn-primary(href=`/category/${item.category}`) View Details

    h1.text-center.mb-4.mt-5 Laptops
    .row
      each item in laptops
        .col-md-3.mb-4
          .card.h-100.p-2
            img.card-img-top(src=item.image)
            .card-body
              h5.card-title= item.title
              p.card-text= item.description
              p.card-text
                b Price: #{item.price}$
              p.card-text
                | In stock: #{item.stock}
            .card-footer
              a.btn.btn-primary(href=`/category/${item.category}`) View Details
