.form-container
    h2 Add New Product

    form(method='POST', action='/products')
      .form-group(class=errors.name ? 'error' : '')
        label(for='name') Product Name *
        input(
          type='text',
          id='name',
          name='name',
          value=formData.name || '',
          placeholder='e.g., Dell XPS 15 Laptop',
          required
        )
        if errors.name
          span.error= errors.name

      .form-group(class=errors.price ? 'error' : '')
        label(for='price') Price ($) *
        input(
          type='number',
          id='price',
          name='price',
          value=formData.price || '',
          placeholder='25000',
          min='0',
          step='0.01',
          required
        )
        if errors.price
          span.error= errors.price

      .form-group(class=errors.category ? 'error' : '')
        label(for='category') Category *
        select(id='category', name='category', required)
          option(value='', disabled, selected=!formData.category) Select a category
          each cat in categories
            option(value=cat, selected=(formData.category === cat))= cat
        if errors.category
          span.error= errors.category

      .form-group(class=errors.quantity ? 'error' : '')
        label(for='quantity') Quantity (pcs)
        input(
          type='number',
          id='quantity',
          name='quantity',
          value=formData.quantity || '0',
          placeholder='10',
          min='0'
        )
        if errors.quantity
          span.error= errors.quantity

      .form-group(class=errors.description ? 'error' : '')
        label(for='description') Description
        textarea(
          id='description',
          name='description',
          placeholder='Detailed product description...'
        )= formData.description || ''
        if errors.description
          span.error= errors.description

      .form-group
        .checkbox-group
          input(
            type='checkbox',
            id='inStock',
            name='inStock',
            checked=formData.inStock !== undefined ? formData.inStock === 'on' : true
          )
          label(for='inStock', style='margin: 0;') In Stock

      .form-actions
        a.btn.btn-secondary(href='/products')  Cancel
        button.btn.btn-success(type='submit')  Save