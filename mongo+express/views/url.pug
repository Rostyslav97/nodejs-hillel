h1 You will be redirected via link
p.count
p
    a(href=`${url}`) #{url} 

script.
    const url = '!{url}';
    let count = 5;
    const countElement = document.querySelector('.count');
    countElement.textContent = count;
    
    const interval = setInterval(function() {
      count--;
      countElement.textContent = count;
      
      if (count === 0) {
        clearInterval(interval);
        window.location.href = url;
      }
    }, 1000);